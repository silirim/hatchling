{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "engine/audit.js",
    "engine/skin-check.js",
    "engine/skin-import.js",
    "engine/image.js",
    "bench/*.mjs"
  ]
}
